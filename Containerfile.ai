###############################################################################
# AI SANDBOX CONTAINER
###############################################################################
# This Containerfile builds the AI sandbox container that runs as a quadlet
# container alongside the Edward (cargoyard) bootc image.
#
# Base: NVIDIA CUDA 12.5.1 (Ubuntu 24.04)
# Purpose: AI workloads, coding assistants, LLM inference
#
# The quadlet definition is in custom/system/etc/containers/systemd/users/ai.container
###############################################################################

FROM docker.io/nvidia/cuda:12.5.1-runtime-ubuntu24.04@sha256:447c60da64e4e18860b640289274ec0103816aa56d410041b162d48e85fb1058

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    unzip \
    vim \
    tmux \
    nano \
    python3 \
    python3-pip \
    ca-certificates \
    sudo \
    locales \
    tzdata \
    libstdc++6 \
    libgcc-s1 \
    libc6 \
    libglib2.0-0 \
    libx11-6 \
    libxext6 \
    libxrandr2 \
    libxss1 \
    libxcursor1 \
    libxi6 \
    libxtst6 \
    libgtk-3-0 \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libasound2t64 \
    libfontconfig1 \
    libfreetype6 \
    libdbus-1-3 \
    libxcb1 \
    libxkbcommon0 \
    libatspi2.0-0 \
    file \
    xz-utils \
    jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22.x (Pi requires >= 22.19.0)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Homebrew
ENV NONINTERACTIVE=1
RUN /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Make brew available for all login shells
ENV PATH="/home/linuxbrew/.linuxbrew/bin:${PATH}"
RUN echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' > /etc/profile.d/linuxbrew.sh

# Install brew packages
RUN eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" \
    && brew tap ublue-os/tap \
    && brew tap ublue-os/experimental-tap \
    && brew tap Kilo-Org/tap \
    && brew trust ublue-os/tap \
    && brew trust ublue-os/experimental-tap \
    && brew install bun ollama llama.cpp opencode \
    && brew install Kilo-Org/tap/kilo \
    && brew install --cask antigravity-cli-linux \
    && brew install --cask ublue-os/experimental-tap/cursor-linux \
    && brew install --cask ublue-os/experimental-tap/kiro-cli-linux

# Install Pi CLI
RUN curl -fsSL https://pi.dev/install.sh | sh

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/usr/bin/sleep", "infinity"]
