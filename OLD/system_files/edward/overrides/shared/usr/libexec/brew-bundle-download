#!/usr/bin/env bash
# Download the upstream Brewfile and apply it with brew bundle.
set -euo pipefail

CONF="/etc/ublue-os/brew-bundle.conf"
BREW_BIN="/var/home/linuxbrew/.linuxbrew/bin/brew"
MAX_WAIT=300

if [[ ! -f "${CONF}" ]]; then
    echo "brew-bundle-download: missing ${CONF}, skipping" >&2
    exit 0
fi

# shellcheck disable=SC1090
source "${CONF}"

: "${BREWFILE_URL:?BREWFILE_URL must be set in ${CONF}}"
: "${BREWFILE_DEST:=/usr/share/ublue-os/homebrew/Brewfile}"

if [[ ! -x "${BREW_BIN}" ]]; then
    echo "brew-bundle-download: waiting for brew-setup.service..."
    waited=0
    while [[ ! -x "${BREW_BIN}" && "${waited}" -lt "${MAX_WAIT}" ]]; do
        sleep 5
        waited=$((waited + 5))
    done
    if [[ ! -x "${BREW_BIN}" ]]; then
        echo "brew-bundle-download: brew not available after ${MAX_WAIT}s, skipping" >&2
        exit 1
    fi
fi

eval "$("${BREW_BIN}" shellenv)"

mkdir -p "$(dirname "${BREWFILE_DEST}")"
echo "brew-bundle-download: fetching ${BREWFILE_URL}"
curl --fail --silent --show-error --location \
    --retry 5 --retry-all-errors --retry-delay 5 \
    -o "${BREWFILE_DEST}.new" "${BREWFILE_URL}"

if [[ -f "${BREWFILE_DEST}" ]] && cmp -s "${BREWFILE_DEST}" "${BREWFILE_DEST}.new"; then
    echo "brew-bundle-download: Brewfile unchanged"
    rm -f "${BREWFILE_DEST}.new"
else
    mv "${BREWFILE_DEST}.new" "${BREWFILE_DEST}"
    echo "brew-bundle-download: updated ${BREWFILE_DEST}"
fi

while IFS= read -r tap_name; do
    [[ -n "${tap_name}" ]] || continue
    echo "brew-bundle-download: trusting tap ${tap_name}"
    "${BREW_BIN}" trust "${tap_name}" >/dev/null 2>&1 || true
done < <(sed -nE 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/p' "${BREWFILE_DEST}")

echo "brew-bundle-download: applying bundle"
exec "${BREW_BIN}" bundle --file="${BREWFILE_DEST}"
