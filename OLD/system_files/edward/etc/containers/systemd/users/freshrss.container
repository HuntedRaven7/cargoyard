[Unit]
Description=FreshRSS feed reader
Documentation=https://github.com/FreshRSS/FreshRSS

[Container]
Image=docker.io/freshrss/freshrss:latest
ContainerName=freshrss
PublishPort=8080:80
Volume=%h/.local/share/freshrss:/var/www/FreshRSS/data:Z
PodmanArgs=--memory=512m --cpus=0.5

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/freshrss
EnvironmentFile=-%h/.config/envs/freshrss/.env
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
