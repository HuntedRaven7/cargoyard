[Unit]
Description=Tailscale sidecar for Pi-hole
After=network-online.target

[Container]
Image=docker.io/tailscale/tailscale:latest
ContainerName=tailscale-pihole
HostName=pihole
PublishPort=8082:80
PublishPort=5353:53/tcp
PublishPort=5353:53/udp
Volume=%h/.local/share/tailscale-pihole:/var/lib/tailscale:Z
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
EnvironmentFile=-%h/.config/envs/tailscale-pihole/.env
PodmanArgs=--cap-add=NET_ADMIN --cap-add=SYS_MODULE --device=/dev/net/tun

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
