[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom5/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom6/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ubuntu/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/arch/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/fedora/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/centos10/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ai/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/review/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ubuntu]
binding='<Control><Alt>u'
command='/usr/bin/container-launch ubuntu'
name='Open Ubuntu Container'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/arch]
binding='<Control><Alt>a'
command='/usr/bin/container-launch arch'
name='Open Arch Container'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/fedora]
binding='<Control><Alt>f'
command='/usr/bin/container-launch fedora'
name='Open Fedora Container'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/centos10]
binding='<Control><Alt>c'
command='/usr/bin/container-launch centos10'
name='Open CentOS 10 Container'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ai]
binding='<Control><Alt>n'
command='/usr/bin/container-launch ai'
name='Open AI Sandbox'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/review]
binding='<Control><Alt>r'
command='/usr/bin/container-launch review'
name='Open Review Container'
