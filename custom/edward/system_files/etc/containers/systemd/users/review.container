[Unit]
Description=Bluefin Review appliance (Hive contributor container)
Documentation=man:podman-systemd.unit(5)
After=network-online.target

[Container]
Image=ghcr.io/projectbluefin/review:stable@sha256:6dd7600e62add6d724b5483818dd2493f79fd61beed24c1ed53b6d59f10baefc
ContainerName=review
HostName=review
Exec=/usr/bin/sleep infinity

# Host networking for GitHub API access
PodmanArgs=--network=host

# GitHub credentials (gh auth login on host is required)
Volume=%h/.config/gh:/root/.config/gh:ro

# Podman socket — review container runs nested podman for builds
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro

# Workspace for cloned repos
Volume=%h/git:/root/workspace:Z

[Service]
Restart=always
RestartSec=5
ExecStartPre=/usr/bin/mkdir -p %h/git
# Check out the projectbluefin/review source into the workspace so it can be
# developed/contributed to from inside the container (run `just` from there).
ExecStartPre=/usr/bin/bash -lc 'test -d %h/git/review || git clone https://github.com/projectbluefin/review %h/git/review'
TimeoutStartSec=900

[Install]
WantedBy=default.target
