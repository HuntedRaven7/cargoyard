[Unit]
Description=TLC Homepage (rootless Podman, Quadlet) — dashboard; Network=host for server-side LAN fetch
After=network-online.target podman.socket
Wants=network-online.target podman.socket

[Container]
ContainerName=tlc-homepage
Image=ghcr.io/huntedraven7/homepage:latest@sha256:13d7147ada0a1b61c5744d7fc4194b6a7429fe17fd2ceb066aef791103a1ee3e
Network=host
Environment=NODE_ENV=production
Environment=PORT=3002
Volume=%h/.local/share/tlc-homepage:/app/data:Z
Volume=/run/user/1000/podman/podman.sock:/var/run/docker.sock:ro
PodmanArgs=--memory=512m --cpus=0.5

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/tlc-homepage
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
