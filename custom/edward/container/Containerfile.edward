###############################################################################
# EDWARD CONTAINERFILE
###############################################################################
# edward desktop image (Arch Linux bootc base, Hyprland + Quickshell).
#
# Usage:
#   podman build -f custom/edward/container/Containerfile.edward -t edward:stable .
#
# The project name is defined by IMAGE_NAME.
# Build scripts live in build/edward/ (pacman, not dnf5).
###############################################################################

###############################################################################
# OCI CONTEXT IMAGES (pinned; digests updated by Renovate)
###############################################################################
FROM ghcr.io/projectbluefin/common:latest@sha256:df2fa93dac84cda91d568bd694e5051abbbdba37bf3d54a6cc15cdc80e645e2c AS common
FROM ghcr.io/ublue-os/brew:latest@sha256:8f952ae54585db9f855a306ef365e13609ed7c7944b12b823ba7d5ce8e1a145b AS brew

###############################################################################
# CONTEXT STAGE
###############################################################################
FROM scratch AS ctx

COPY build/edward /build
COPY custom/edward /custom

# Copy system files (quadlets, launchers, desktop entries)
COPY custom/edward/system_files /system_files

# Copy from OCI containers to distinct subdirectories to avoid conflicts
COPY --from=common /system_files /oci/common
COPY --from=brew /system_files /oci/brew

###############################################################################
# BASE IMAGE
###############################################################################
# Arch Linux bootc base. Digest pinned; Renovate keeps it fresh.
FROM ghcr.io/huntedraven7/arch-bootc:testing@sha256:e257cd66ae88c8e46bce581eed786fb638d3355d1061197be9fbc8061b3e7533 AS base

###############################################################################
# IMAGE IDENTITY
###############################################################################
ARG IMAGE_VENDOR="huntedraven7"
ARG UBLUE_IMAGE_TAG="stable"
ARG VERSION=""
ARG IMAGE_NAME="edward"

# hadolint ignore=SC3040
RUN <<SET_NAME
#!/bin/bash
set -euo pipefail
echo "IMAGE_NAME=${IMAGE_NAME}"
# Write to /etc/environment for build scripts
echo "IMAGE_NAME=${IMAGE_NAME}" >> /etc/environment
SET_NAME

ARG BASE_IMAGE_NAME_DEFAULT

### MODIFICATIONS
## The RUN directives below mount the ctx stage, which includes build scripts,
## custom files, @projectbluefin/common, and @ublue-os/brew.

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/boot \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build/00-image-info.sh

# Arch base: no dnf.conf hardlink workaround needed. The pacman package cache
# is mounted so repeat builds reuse downloaded packages.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache/pacman/pkg \
    --mount=type=secret,id=GITHUB_TOKEN \
    --mount=type=tmpfs,dst=/boot \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build/10-build.sh

### CLEANUP
## Use Bluefin's clean-stage.sh to remove build artifacts before linting.
## /run and /tmp are deliberately NOT mounted as tmpfs here: the arch-bootc
## base ships content in them (/tmp/.X11-unix & friends) and clean-stage.sh
## must delete image-layer files so bootc lint's nonempty-run-tmp check
## passes. The script tolerates busy Buildah bind mounts while clearing.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build/clean-stage.sh

### /opt
## Makes /opt writeable by default. This is for downstream images/stuff like k0s.
RUN rm -rf /opt && ln -s /var/opt /opt

### INIT
## Required for bootc images
CMD ["/sbin/init"]

### LINTING
## Verify final image and contents are correct. --fatal-warnings catches issues.
RUN bootc container lint --fatal-warnings
