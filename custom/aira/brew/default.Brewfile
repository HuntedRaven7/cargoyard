# Default Brewfile for cargoyard
# Users install via: ujust install-default-apps

tap "ublue-os/tap", trusted: true
tap "ublue-os/experimental-tap", trusted: true

cask "devpod-linux"
cask "visual-studio-code-linux"
cask "lm-studio-linux"
cask "zed-linux"
cask "jetbrains-toolbox-linux"

brew "eza"
brew "bun"
brew "starship"
brew "uv"
brew "rustup"
brew "atuin"
brew "bat"
brew "fzf"
brew "gh"
brew "cosign"
brew "stow"
brew "fd"
brew "dysk"
brew "opencode"
brew "npm"
