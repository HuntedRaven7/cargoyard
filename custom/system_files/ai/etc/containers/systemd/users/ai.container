[Unit]
Description=AI Sandbox container (Docker Sandboxes-style)
Documentation=man:podman-systemd.unit(5)
After=network-online.target

[Container]
Image=ghcr.io/huntedraven7/blueprint:ai@sha256:98620b1261b5ea54092e6fe9987aa5efd393c12413d49af0e193e2c820a69895
ContainerName=ai
HostName=ai-sandbox
Exec=/usr/bin/sleep infinity

# GPU access for AI workloads
PodmanArgs=--memory=4g --cpus=2 --gpus all

# Persistent AI agent home (separate from workspace)
Volume=%h/.local/share/ai/home:/root:Z
Volume=%h/.local/share/ai/cache:/root/.cache:Z

# Workspace: ~/git is the main dev directory
Volume=%h/git:/workspace:Z

# Podman socket — lets the agent spin up its own containers (Docker-in-Docker)
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro

# Network: use host networking for model downloads and API access
# Remove or change to --network=none for fully air-gapped mode
PodmanArgs=--network=host

# Security: no host credentials leaked into the sandbox
# (SSH keys, gitconfig, API tokens stay on the host)

[Service]
Restart=always
RestartSec=5
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/ai/home %h/.local/share/ai/cache %h/git
TimeoutStartSec=900

[Install]
WantedBy=default.target
