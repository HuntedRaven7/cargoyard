[Unit]
Description=Enable quadlet auto-start (linger + podman-restart) for server users
Documentation=https://github.com/ublue-os/ucore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/ublue-os/server/enable-quadlet-autostart.sh

[Install]
WantedBy=multi-user.target
